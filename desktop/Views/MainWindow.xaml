<Window x:Class="Cadenza.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Cadenza.Core.Models" Title="Cadenza">
    <Grid x:Name="Root" RequestedTheme="Light" Background="Transparent" KeyDown="Root_KeyDown" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border x:Name="SolidBackground" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{ThemeResource SolidWindow}" IsHitTestVisible="False" />
        <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{ThemeResource WindowWash}" IsHitTestVisible="False" />

        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent"><TextBlock Text="Cadenza" FontSize="12" Foreground="{ThemeResource MutedText}" Margin="22,0,0,0" VerticalAlignment="Center"/></Grid>

        <Border Grid.Row="1" Margin="16,0,0,8" Style="{StaticResource GlassCardStyle}" CornerRadius="26" Padding="12,28,12,16">
            <Grid RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="4" Padding="10,0"><TextBlock Text="cadenza" FontSize="28" FontWeight="SemiBold" CharacterSpacing="-40"/><TextBlock Text="A space for your sound" FontSize="12" Foreground="{ThemeResource MutedText}"/></StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAnchorRatio="NaN"><StackPanel Spacing="4">
                    <Button x:Name="NavLibrary" Tag="Library" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Library"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontSize="16"/><TextBlock Text="Library"/></StackPanel></Button>
                    <Button x:Name="NavSearch" Tag="Search" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Search"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE721;" FontSize="16"/><TextBlock Text="Search"/></StackPanel></Button>
                    <Button x:Name="NavPlaylists" Tag="Playlists" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Playlists"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE93C;" FontSize="16"/><TextBlock Text="Playlists"/></StackPanel></Button>
                    <Button x:Name="NavQueue" Tag="Queue" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Queue"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8FD;" FontSize="16"/><TextBlock Text="Queue"/></StackPanel></Button>
                    <StackPanel x:Name="SidebarPlaylists" Visibility="Collapsed" Spacing="2" Margin="0,18,0,0">
                        <TextBlock Text="PLAYLISTS" Style="{StaticResource EyebrowTextStyle}" FontSize="10" Margin="12,0,0,6"/>
                        <ItemsControl ItemsSource="{x:Bind PinnedPlaylists}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Playlist">
                                <Button Tag="{x:Bind}" Click="PinnedPlaylist_Click" Style="{StaticResource NavButtonStyle}" Height="48" Padding="8,0" AutomationProperties.Name="{x:Bind Name}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource ArtTile}" BorderBrush="{StaticResource ArtEdge}" BorderThickness="1"><Grid><Image Source="{Binding ArtworkUrl, Converter={StaticResource ArtworkConverter}, ConverterParameter=64}" Stretch="UniformToFill"/></Grid></Border>
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel></ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,0"><Ellipse Width="8" Height="8" Fill="{ThemeResource Accent}" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionLabel" Text="Spotify disconnected" Foreground="{ThemeResource MutedText}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                    <Button x:Name="NavSettings" Tag="Settings" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Settings"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Padding="24,8,24,16" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom"><TextBlock Text="YOUR MUSIC, YOUR MOMENT" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="PageTitle" Text="Your library" FontSize="36" FontWeight="SemiBold" CharacterSpacing="-20" Margin="0,4,0,0"/></StackPanel>
                <Grid x:Name="SearchPanel" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Find your next favourite   ·   Ctrl+K" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" AutomationProperties.Name="Search Spotify" CornerRadius="24" MinHeight="48" Width="360" Padding="20,13,16,0" FontSize="14" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Click="Search_Click" Style="{StaticResource RoundAccentButtonStyle}" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search"><FontIcon Glyph="&#xE721;" FontSize="16"/></Button>
                </Grid>
            </Grid>
            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" HorizontalAlignment="Stretch" CornerRadius="14"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="PlaylistDetail" Visibility="Collapsed" Margin="0,0,0,18">
                    <Border Style="{StaticResource GlassCardStyle}" CornerRadius="16" Padding="22">
                        <Grid ColumnSpacing="26"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="160" Height="160" CornerRadius="20" Background="{StaticResource ArtTile}" BorderBrush="{StaticResource ArtEdge}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="PlaylistHeroImage" Stretch="UniformToFill"/>

                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <Button Click="BackToPlaylists_Click" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="8,6" MinHeight="32"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="All playlists" FontSize="13"/></StackPanel></Button>
                                <TextBlock Text="PLAYLIST" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBlock x:Name="PlaylistHeroTitle" FontSize="34" FontWeight="Bold" CharacterSpacing="-30" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PlaylistHeroSubtitle" Foreground="{ThemeResource MutedText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="TrackPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource GlassCardStyle}" Padding="8">
                    <ListView x:Name="TrackList" SelectionChanged="QueueSelection_Changed" SelectionMode="Single" HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind Tracks}" AutomationProperties.Name="Tracks">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="CornerRadius" Value="14"/><Setter Property="Margin" Value="0,2"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Track">
                                <Grid Padding="4,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource ArtTile}" BorderBrush="{StaticResource ArtEdge}" BorderThickness="1"><Grid><Image Source="{Binding ArtworkUrl, Converter={StaticResource ArtworkConverter}, ConverterParameter=96}" Stretch="UniformToFill"/></Grid></Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource MutedText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Album}" Foreground="{ThemeResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Duration}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource MutedText}" FontSize="13"/>
                                    <Button Grid.Column="3" Tag="{x:Bind}" Click="PlayTrack_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Play track in Cadenza" ToolTipService.ToolTip="Play"><FontIcon Glyph="&#xE768;" FontSize="14"/></Button>
                                    <Button Grid.Column="4" Tag="{x:Bind}" Click="Add_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Add track to listening queue" ToolTipService.ToolTip="Add to queue"><Button.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Play next" Tag="{x:Bind}" Click="PlayNextMenu_Click"/></MenuFlyout></Button.ContextFlyout><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
                                    <HyperlinkButton Grid.Column="5" Tag="{x:Bind}" Click="OpenTrack_Click" Style="{StaticResource IconLinkStyle}" AutomationProperties.Name="Open track on Spotify" ToolTipService.ToolTip="Open on Spotify"><FontIcon Glyph="&#xE8A7;" FontSize="14"/></HyperlinkButton>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <GridView Grid.RowSpan="2" x:Name="PlaylistCards" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="PlaylistCard_Click" SelectionMode="None" ItemsSource="{x:Bind Playlists}" Padding="0,0,0,16" AutomationProperties.Name="Playlist covers">
                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}"><Setter Property="Margin" Value="0,0,14,16"/><Setter Property="CornerRadius" Value="22"/></Style></GridView.ItemContainerStyle>
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemTemplate><DataTemplate x:DataType="core:Playlist">
                        <Border Width="208" Padding="11,11,11,0" Style="{StaticResource AlbumCardStyle}" CornerRadius="16">
                            <StackPanel Spacing="4">
                                <Border Height="184" CornerRadius="10" Background="{StaticResource ArtTile}" BorderBrush="{StaticResource ArtEdge}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding ArtworkUrl, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill" AutomationProperties.Name="Playlist cover"/>

                                    </Grid>
                                </Border>
                                <Border Margin="0" Padding="4,8,4,12" Background="{ThemeResource CaptionBand}" BorderBrush="{ThemeResource CaptionEdge}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate></GridView.ItemTemplate>
                </GridView>

                <GridView Grid.RowSpan="2" x:Name="LibraryCards" ItemsSource="{x:Bind Tracks}" IsItemClickEnabled="True" ItemClick="LibraryCard_Click" SelectionMode="Single" Padding="0,0,0,16" AutomationProperties.Name="Library album covers">
                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}"><Setter Property="Margin" Value="0,0,14,16"/><Setter Property="CornerRadius" Value="22"/></Style></GridView.ItemContainerStyle>
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemTemplate><DataTemplate x:DataType="core:Track">
                        <Border Width="208" Padding="11,11,11,0" Style="{StaticResource AlbumCardStyle}" CornerRadius="16">
                            <StackPanel Spacing="4">
                                <Border Height="184" CornerRadius="10" Background="{StaticResource ArtTile}" BorderBrush="{StaticResource ArtEdge}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding ArtworkUrl, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill"/>

                                        <Button Tag="{x:Bind}" Click="PlayTrack_Click" Style="{StaticResource AccentButtonStyle}" Width="46" Height="46" Padding="0" CornerRadius="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" AutomationProperties.Name="Play track in Cadenza" ToolTipService.ToolTip="Play"><FontIcon Glyph="&#xE768;" FontSize="14"/></Button>
                                    </Grid>
                                </Border>
                                <Border Margin="0" Padding="4,8,0,12" Background="{ThemeResource CaptionBand}" BorderBrush="{ThemeResource CaptionEdge}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                                    <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Tag="{x:Bind}" Click="Add_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Add track to queue" ToolTipService.ToolTip="Add to queue"><Button.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Play next" Tag="{x:Bind}" Click="PlayNextMenu_Click"/></MenuFlyout></Button.ContextFlyout><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate></GridView.ItemTemplate>
                </GridView>

                <Border Grid.Row="1" x:Name="EmptyState" Style="{StaticResource GlassCardStyle}" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="36,40">
                    <StackPanel Spacing="14">
                        <FontIcon Glyph="&#xE8D6;" FontSize="40" Foreground="{ThemeResource Accent}"/>
                        <TextBlock x:Name="EmptyTitle" Text="Make room for your music" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyDescription" Text="Connect Spotify in Settings. Your albums and playlists will find a home here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MutedText}"/>
                        <Button Content="Connect Spotify" Tag="Settings" Click="Navigate_Click" HorizontalAlignment="Center" Style="{StaticResource PillAccentButtonStyle}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.RowSpan="2" x:Name="SettingsPanel" Visibility="Collapsed" Padding="0,0,16,32" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">
                        <Border Style="{StaticResource GlassCardStyle}" Padding="26">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}"/>
                                <ComboBox x:Name="AppearanceBox" Header="Window material" SelectedIndex="0" SelectionChanged="Appearance_SelectionChanged" MinWidth="220">
                                    <ComboBoxItem Content="Acrylic"/>
                                    <ComboBoxItem Content="Mica"/>
                                    <ComboBoxItem Content="Solid"/>
                                </ComboBox>
                                <TextBlock Text="Acrylic shows a live, blurred view behind Cadenza. Mica uses the Windows wallpaper tint. Solid removes background effects. Windows transparency and contrast preferences take priority." Foreground="{ThemeResource MutedText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCardStyle}" Padding="26">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Connect Spotify" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Use your own Spotify developer Client ID. No client secret is needed." TextWrapping="Wrap" Foreground="{ThemeResource MutedText}"/>
                                <TextBox x:Name="ClientIdBox" Header="Spotify Client ID" PlaceholderText="32-character Client ID" CornerRadius="12"/>
                                <TextBox x:Name="RedirectUriBox" Header="Redirect URL" PlaceholderText="http://127.0.0.1:8888/callback" CornerRadius="12"/>
                                <TextBlock Text="Register the same redirect URL in your Spotify developer app." Foreground="{ThemeResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ConnectButton" Content="Connect Spotify" Click="Connect_Click" Style="{StaticResource PillAccentButtonStyle}"/>
                                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" CornerRadius="22" MinHeight="44" Padding="20,10"/>
                                    <HyperlinkButton Content="Developer dashboard ↗" NavigateUri="https://developer.spotify.com/dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="{ThemeResource GlassSurface}" BorderBrush="{ThemeResource GlassEdge}" BorderThickness="1" CornerRadius="16" Padding="14,12">
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource MutedText}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Your sign-in is stored in Windows Credential Manager. Disconnect clears it and this session's Spotify data. Queue contents are kept only in memory." TextWrapping="Wrap" Foreground="{ThemeResource MutedText}" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCardStyle}" Padding="26">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Queue preferences" Style="{StaticResource SectionTitleStyle}"/>
                                <NumberBox x:Name="SpacingBox" Header="Artist spacing when shuffling" Minimum="0" Maximum="10" Value="2" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="220"/>
                                <TextBlock Text="Try to leave this many tracks between the same lead artist. If that is impossible, spacing is relaxed. All tracks remain in the queue." TextWrapping="Wrap" Foreground="{ThemeResource MutedText}"/>
                                <Button Content="Save preferences" Click="SavePreferences_Click" CornerRadius="22" Padding="20,10"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCardStyle}" Padding="26">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Playback integration" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Background="{ThemeResource GlassSurface}" BorderBrush="{ThemeResource GlassEdge}" BorderThickness="1" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"><TextBlock Text="EXPERIMENTAL" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource Accent}"/></Border>
                                </StackPanel>
                                <TextBlock Text="Experimental librespot playback uses Windows audio output. Reconnect Spotify after updating to grant the streaming scope. Live account compatibility still needs validation." TextWrapping="Wrap" Foreground="{ThemeResource MutedText}"/>
                                <Button Content="Check native bridge" Click="CheckBridge_Click" CornerRadius="22" Padding="20,10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ProgressRing x:Name="Loading" IsActive="False" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="MoreButton" Content="Load more" Visibility="Collapsed" Click="More_Click" CornerRadius="24" Padding="20,10" Background="{ThemeResource NavSelectedBrush}" BorderBrush="{ThemeResource GlassEdge}"/>
                    <Button x:Name="QueueLoadedButton" Content="Queue loaded tracks" Click="QueueLoaded_Click" Visibility="Collapsed"/>
                    <StackPanel x:Name="QueueTools" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="QueuePlayButton" Content="Play queue" Click="QueuePlay_Click"/>
                        <Button x:Name="QueueUpButton" Click="Up_Click" AutomationProperties.Name="Move selected track up" ToolTipService.ToolTip="Move up" Width="40" Padding="0"><FontIcon Glyph="&#xE70E;" FontSize="14"/></Button>
                        <Button x:Name="QueueDownButton" Click="Down_Click" AutomationProperties.Name="Move selected track down" ToolTipService.ToolTip="Move down" Width="40" Padding="0"><FontIcon Glyph="&#xE70D;" FontSize="14"/></Button>
                        <Button x:Name="QueueRemoveButton" Click="Remove_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14"/><TextBlock Text="Remove"/></StackPanel></Button>
                        <Button x:Name="QueueUndoButton" Click="Undo_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="14"/><TextBlock Text="Undo"/></StackPanel></Button>
                        <Button x:Name="QueueShuffleButton" Click="Shuffle_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="14" Padding="14,9" MinHeight="40"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B1;" FontSize="14"/><TextBlock Text="Shuffle with spacing"/></StackPanel></Button>
                        <Button x:Name="QueueClearButton" Click="Clear_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE894;" FontSize="14"/><TextBlock Text="Clear"/></StackPanel></Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource GlassCardStyle}" CornerRadius="24" Margin="16,0,16,12" Padding="20,12">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid ColumnSpacing="14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource ArtTile}" BorderBrush="{StaticResource ArtEdge}" BorderThickness="1"><Grid><Image x:Name="NowPlayingImage" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="NowPlayingLabel" Text="Choose a track to play" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QueueLabel" Text="0 tracks" Foreground="{ThemeResource MutedText}" FontSize="12"/></StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Click="ShuffleQueue_Click" Style="{StaticResource IconButtonStyle}" Foreground="{ThemeResource Accent}" AutomationProperties.Name="Shuffle queue with artist spacing" ToolTipService.ToolTip="Shuffle queue"><FontIcon Glyph="&#xE8B1;" FontSize="14"/></Button>
                        <Button Click="Stop_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Stop" ToolTipService.ToolTip="Stop"><FontIcon Glyph="&#xE71A;" FontSize="14"/></Button>
                        <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{StaticResource RoundAccentButtonStyle}" AutomationProperties.Name="Play" ToolTipService.ToolTip="Play or pause"><FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="18"/></Button>
                        <Button Click="Next_Click" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Next" ToolTipService.ToolTip="Next in queue"><FontIcon Glyph="&#xE893;" FontSize="14"/></Button>
                    </StackPanel>
                    <Grid ColumnSpacing="12" MaxWidth="620">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" IsEnabled="False" IsThumbToolTipEnabled="False" AutomationProperties.Name="Playback position" PointerPressed="Position_Pressed" PointerReleased="Position_Released" KeyDown="Position_KeyDown" KeyUp="Position_KeyUp" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlaybackLabel" Grid.Column="1" Text="Not playing" Foreground="{ThemeResource MutedText}" FontSize="12" VerticalAlignment="Center" MinWidth="90"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource MutedText}"/>
                    <Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100" Value="25" StepFrequency="1" AutomationProperties.Name="Playback volume" PointerReleased="Volume_Released" KeyUp="Volume_KeyUp" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
