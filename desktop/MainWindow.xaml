<Window x:Class="ApurvaSpotify.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ApurvaSpotify.Core"
    Title="ApurvaSpotify">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#11151C" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="#171C25" Padding="22,30">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="APURVA" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Your listening space" Foreground="#9EAABB" FontSize="12" Margin="0,0,0,28"/>
                    <Button Content="Library" Tag="Library" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
                    <Button Content="Search" Tag="Search" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
                    <Button Content="Playlists" Tag="Playlists" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
                    <Button Content="Listening queue" Tag="Queue" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="12">
                    <TextBlock x:Name="ConnectionLabel" Text="Spotify disconnected" Foreground="#9EAABB" FontSize="12" TextWrapping="Wrap"/>
                    <Button Content="Settings" Tag="Settings" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Padding="30,28,30,18" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="LISTEN WITH INTENTION" FontSize="11" CharacterSpacing="150" Foreground="#9EAABB"/>
                <TextBlock x:Name="PageTitle" Text="Your library" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="True" Severity="Informational" IsClosable="True"
                Message="Connect in Settings to browse Spotify. Standalone audio playback is not available in this build."/>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Find a track or artist   ·   Ctrl+K" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" AutomationProperties.Name="Search Spotify"/>
                <Button Grid.Column="1" Content="Search" Click="Search_Click"/>
            </Grid>
            <ComboBox x:Name="PlaylistPicker" Grid.Row="3" Visibility="Collapsed" PlaceholderText="Choose a playlist" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="Playlist_Changed"/>
            <Grid Grid.Row="4">
                <ListView x:Name="TrackList" SelectionMode="Single" ItemsSource="{x:Bind Tracks}" AutomationProperties.Name="Tracks">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:Track">
                            <Grid Padding="4,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Artist}" Foreground="#A5B1C2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Album}" Foreground="#778498" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Duration}" VerticalAlignment="Center" Foreground="#A5B1C2"/>
                                <Button Grid.Column="2" Content="+ Queue" Tag="{x:Bind}" Click="Add_Click" VerticalAlignment="Center" AutomationProperties.Name="Add track to listening queue"/>
                                <HyperlinkButton Grid.Column="3" Content="Spotify ↗" Tag="{x:Bind}" Click="OpenTrack_Click" VerticalAlignment="Center" AutomationProperties.Name="Open track on Spotify"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <TextBlock x:Name="EmptyTitle" Text="Make room for your music" FontSize="23" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyDescription" Text="Connect Spotify in Settings to browse your library, then build a listening queue." TextWrapping="Wrap" TextAlignment="Center" Foreground="#9EAABB"/>
                </StackPanel>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Connect Spotify" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Use your own Spotify developer Client ID. No client secret is needed." TextWrapping="Wrap" Foreground="#A5B1C2"/>
                        <TextBox x:Name="ClientIdBox" Header="Spotify Client ID" PlaceholderText="32-character Client ID"/>
                        <TextBlock Text="Register this exact redirect URI in your developer app:" Foreground="#A5B1C2" TextWrapping="Wrap"/>
                        <TextBlock Text="http://127.0.0.1:8888/callback" IsTextSelectionEnabled="True" FontFamily="Consolas"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ConnectButton" Content="Connect Spotify" Click="Connect_Click"/>
                            <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click"/>
                            <HyperlinkButton Content="Developer dashboard ↗" NavigateUri="https://developer.spotify.com/dashboard"/>
                        </StackPanel>
                        <TextBlock Text="Queue preferences" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"/>
                        <NumberBox x:Name="SpacingBox" Header="Artist spacing when shuffling" Minimum="0" Maximum="10" Value="2" SpinButtonPlacementMode="Inline"/>
                        <TextBlock Text="Try to leave this many tracks between the same lead artist. If that is impossible, spacing is relaxed. All tracks remain in the queue." TextWrapping="Wrap" Foreground="#A5B1C2"/>
                        <Button Content="Save preferences" Click="SavePreferences_Click"/>
                        <TextBlock Text="Playback integration" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"/>
                        <TextBlock Text="The Rust worker and command bridge can be tested here. Spotify streaming is not connected yet." TextWrapping="Wrap" Foreground="#A5B1C2"/>
                        <Button Content="Check native bridge" Click="CheckBridge_Click"/>
                        <TextBlock Text="Your sign-in is stored in Windows Credential Manager. Disconnect clears it and this session's Spotify data. Queue contents are kept only in memory." TextWrapping="Wrap" Foreground="#778498" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
                <ProgressRing x:Name="Loading" IsActive="False" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                <Button x:Name="MoreButton" Content="Load more" Visibility="Collapsed" Click="More_Click"/>
                <StackPanel x:Name="QueueTools" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button Content="↑" Click="Up_Click" AutomationProperties.Name="Move selected track up"/>
                    <Button Content="↓" Click="Down_Click" AutomationProperties.Name="Move selected track down"/>
                    <Button Content="Remove" Click="Remove_Click"/>
                    <Button Content="Undo" Click="Undo_Click"/>
                    <Button Content="Shuffle with spacing" Click="Shuffle_Click"/>
                    <Button Content="Clear" Click="Clear_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Column="1" Grid.Row="1" Background="#1C2330" Padding="30,16">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource Accent}"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="Your queue, your order" FontWeight="SemiBold"/>
                    <TextBlock x:Name="QueueLabel" Text="0 tracks · standalone playback pending" Foreground="#9EAABB" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
