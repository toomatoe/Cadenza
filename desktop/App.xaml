<Application x:Class="Cadenza.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Cadenza.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Background alpha belongs to brushes; content remains opaque. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#1469DE</Color>
                    <Color x:Key="SystemAccentColorLight1">#3882E5</Color>
                    <Color x:Key="SystemAccentColorLight2">#71A5EC</Color>
                    <Color x:Key="SystemAccentColorLight3">#AECDF5</Color>
                    <Color x:Key="SystemAccentColorDark1">#115AC0</Color>
                    <Color x:Key="SystemAccentColorDark2">#10488F</Color>
                    <Color x:Key="SystemAccentColorDark3">#103866</Color>
                    <SolidColorBrush x:Key="Accent" Color="#1469DE" />
                    <SolidColorBrush x:Key="Ink" Color="#17283E" />
                    <SolidColorBrush x:Key="MutedText" Color="#526278" />
                    <SolidColorBrush x:Key="SolidWindow" Color="#E7EDF7" />
                    <SolidColorBrush x:Key="WindowWash" Color="#041469DE" />
                    <SolidColorBrush x:Key="GlassSurface" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="GlassEdge" Color="#D6FFFFFF" />
                    <SolidColorBrush x:Key="CaptionBand" Color="Transparent" />
                    <SolidColorBrush x:Key="CaptionEdge" Color="Transparent" />
                    <SolidColorBrush x:Key="CardSurface" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="NavIdleBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Accent" Color="#83B8F4" />
                    <SolidColorBrush x:Key="Ink" Color="#F3F6FC" />
                    <SolidColorBrush x:Key="MutedText" Color="#B6C3D4" />
                    <SolidColorBrush x:Key="SolidWindow" Color="#20242B" />
                    <SolidColorBrush x:Key="WindowWash" Color="#0C4A8EDB" />
                    <SolidColorBrush x:Key="GlassSurface" Color="#182D3F58" />
                    <SolidColorBrush x:Key="GlassEdge" Color="#506F829B" />
                    <SolidColorBrush x:Key="CaptionBand" Color="Transparent" />
                    <SolidColorBrush x:Key="CaptionEdge" Color="Transparent" />
                    <SolidColorBrush x:Key="CardSurface" Color="#102D3F58" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#384A8EDB" />
                    <SolidColorBrush x:Key="NavIdleBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="Accent" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Ink" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedText" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SolidWindow" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WindowWash" Color="Transparent" />
                    <SolidColorBrush x:Key="GlassSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassEdge" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CaptionBand" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CaptionEdge" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavIdleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Opaque neutral fallback; real cover art supplies the color. -->
            <SolidColorBrush x:Key="ArtTile" Color="#CAD6E6" />
            <SolidColorBrush x:Key="ArtEdge" Color="#40FFFFFF" />
            <local:ArtworkConverter x:Key="ArtworkConverter" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource Ink}" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="{ThemeResource NavIdleBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NavIdleBrush}" />
            </Style>
            <Style x:Key="PillAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="MinHeight" Value="44" />
            </Style>
            <Style x:Key="RoundAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>
            <Style x:Key="IconLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <Style x:Key="AlbumCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                <Setter Property="Background" Value="{ThemeResource CardSurface}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="180" />
                <Setter Property="Foreground" Value="{ThemeResource MutedText}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
