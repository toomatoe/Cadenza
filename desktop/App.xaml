<Application x:Class="Cadenza.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Cadenza.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Accent" Color="#C7B5FF" />
            <SolidColorBrush x:Key="MutedText" Color="#C2BCD2" />
            <SolidColorBrush x:Key="GlassEdge" Color="#30FFFFFF" />
            <AcrylicBrush x:Key="GlassSurface" TintColor="#252438" TintOpacity="0.65" FallbackColor="#28283B" />
            <local:ArtworkConverter x:Key="ArtworkConverter" />
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="BorderBrush" Value="#26FFFFFF" />
                <Setter Property="MinHeight" Value="42" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
